[Unit]
Description=Renew the VectorCP IP certificate
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=oneshot
User=root
ExecStart=/opt/veyra-certbot/bin/certbot renew --quiet --cert-name veyra-panel-ip --deploy-hook /usr/local/libexec/veyra-cert-renew
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/etc/letsencrypt /var/lib/letsencrypt /var/log/letsencrypt /srv/veyrapanel/acme /var/log/nginx
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

