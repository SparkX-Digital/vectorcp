[Unit]
Description=VectorCP private HTTP interface
After=vectorcp-agent.service
Requires=vectorcp-agent.service

[Service]
Type=simple
User=vectorcp-web
Group=vectorcp-web
WorkingDirectory=/opt/vectorcp
ExecStart=/usr/bin/python3 -m vectorcp.web --private --origin http://127.0.0.1:8765
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
